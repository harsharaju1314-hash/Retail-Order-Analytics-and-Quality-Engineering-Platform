        {
          "name": "List Orders with Status Filter (200 OK)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders?status=DELIVERED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [{"key": "status", "value": "DELIVERED"}]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All orders in list are DELIVERED', function () {",
                  "    var json = pm.response.json();",
                  "    json.orders.forEach(function(o) {",
                  "        pm.expect(o.status).to.eql('DELIVERED');",
                  "    });",
                  "});"
