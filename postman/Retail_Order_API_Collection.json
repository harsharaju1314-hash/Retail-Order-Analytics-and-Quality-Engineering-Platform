    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order - Valid Multi-Item (201 Created)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"payment_method\": \"Credit Card\",\n  \"items\": [\n    {\"product_id\": 1, \"quantity\": 1},\n    {\"product_id\": 2, \"quantity\": 1}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Order financial totals and items are verified', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.order.status).to.eql('PENDING');",
                  "    pm.expect(json.order.items.length).to.eql(2);",
                  "    pm.expect(json.order.subtotal).to.be.above(0);",
                  "    pm.collectionVariables.set('createdOrderId', json.order.order_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
