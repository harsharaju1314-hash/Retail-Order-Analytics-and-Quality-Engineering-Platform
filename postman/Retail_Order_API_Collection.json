  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer - Positive (201 Created)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Rachel\",\n  \"last_name\": \"Green\",\n  \"email\": \"rachel.green@example.com\",\n  \"phone\": \"212-555-0199\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"country\": \"USA\",\n  \"postal_code\": \"10010\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Customer record contains ID and matching email', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.customer).to.have.property('customer_id');",
                  "    pm.expect(json.customer.email).to.eql('rachel.green@example.com');",
                  "    pm.collectionVariables.set('newCustomerId', json.customer.customer_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Customer - Missing Required Field (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"MissingEmail\",\n  \"last_name\": \"User\",\n  \"city\": \"Chicago\",\n  \"state\": \"IL\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/customers", "host": ["{{baseUrl}}"], "path": ["api", "customers"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error specifies missing email field', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
